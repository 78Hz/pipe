/* Pipe - embeds the prepared impulse responses (generated by CMake). */
#if defined(__APPLE__)
    .section __TEXT,__const
    .globl _pipe_ir_blob
    .globl _pipe_ir_blob_end
    .p2align 4
_pipe_ir_blob:
    .incbin "@PIPE_IR_BLOB@"
_pipe_ir_blob_end:
    .byte 0
#elif defined(_WIN32)
    .section .rdata,"dr"
    .globl pipe_ir_blob
    .globl pipe_ir_blob_end
    .p2align 4
pipe_ir_blob:
    .incbin "@PIPE_IR_BLOB@"
pipe_ir_blob_end:
    .byte 0
#else
    .section .rodata
    .globl pipe_ir_blob
    .globl pipe_ir_blob_end
    .type pipe_ir_blob, @object
    .balign 16
pipe_ir_blob:
    .incbin "@PIPE_IR_BLOB@"
pipe_ir_blob_end:
    .byte 0
    .section .note.GNU-stack,"",@progbits
#endif
