+    void addNoteExpression(const clap_event_note_expression_t* const event) noexcept
+    {
+        if (event->port_index > 0 || fMidiEventCount == kMaxMidiEvents)
+            return;
+
+        const int channel = event->channel >= 0 ? (event->channel & 0x0F) : 0;
+        MidiEvent& midiEvent(fMidiEvents[fMidiEventCount]);
+        midiEvent.frame = event->header.time;
+
+        switch (event->expression_id)
+        {
+        case CLAP_NOTE_EXPRESSION_PRESSURE:
+        {
+            const int v = std::max(0, std::min(127, static_cast<int>(event->value * 127 + 0.5)));
+            if (event->channel >= 0)
+            {
+                midiEvent.size = 2;
+                midiEvent.data[0] = 0xD0 | channel;
+                midiEvent.data[1] = v;
+                midiEvent.data[2] = 0;
+            }
+            else
+            {
+                if (event->key < 0)
+                    return;
+                midiEvent.size = 3;
+                midiEvent.data[0] = 0xA0;
+                midiEvent.data[1] = event->key & 0x7F;
+                midiEvent.data[2] = v;
+            }
+            break;
+        }
+        case CLAP_NOTE_EXPRESSION_BRIGHTNESS:
+            midiEvent.size = 3;
+            midiEvent.data[0] = 0xB0 | channel;
+            midiEvent.data[1] = 74;
+            midiEvent.data[2] = std::max(0, std::min(127, static_cast<int>(event->value * 127 + 0.5)));
+            break;
+        case CLAP_NOTE_EXPRESSION_TUNING:
+        {
+            // semitones, sent as MPE pitch bend (member channels bend +-48 semitones)
+            const int v = std::max(0, std::min(16383, static_cast<int>(8192 + event->value / 48.0 * 8192.0)));
+            midiEvent.size = 3;
+            midiEvent.data[0] = 0xE0 | channel;
+            midiEvent.data[1] = v & 0x7F;
+            midiEvent.data[2] = v >> 7;
+            break;
+        }
+        default:
+            return;
+        }
+
+        ++fMidiEventCount;
+    }
+
