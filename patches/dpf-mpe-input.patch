+
+    void addNoteEvent(const clap_event_note_t* const event, const bool isOn) noexcept
+    {
+        if (event->port_index > 0)
+            return;
+
+        if (isOn)
+        {
+            if (event->channel < 0 || event->key < 0)
+                return;
+            addMidiNote(event->header.time, true, event->channel, event->key, event->velocity);
+            // remember the voice so expressions can find it
+            for (uint32_t i = 0; i < fClapNoteCount; ++i)
+                if (fClapNotes[i].channel == event->channel && fClapNotes[i].key == event->key)
+                    { fClapNotes[i] = fClapNotes[--fClapNoteCount]; break; }
+            if (fClapNoteCount < 256)
+                fClapNotes[fClapNoteCount++] = { event->note_id, event->channel, event->key };
+            return;
+        }
