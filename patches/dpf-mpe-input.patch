+                return;
+            uint8_t* const d = fExprData[fMidiEventCount];
+            d[0] = 0xF4; d[1] = static_cast<uint8_t>(type);
+            d[2] = static_cast<uint8_t>(n.channel & 0x0F); d[3] = static_cast<uint8_t>(n.key & 0x7F);
+            d[4] = q & 0x7F; d[5] = (q >> 7) & 0x7F; d[6] = (q >> 14) & 0x7F;
