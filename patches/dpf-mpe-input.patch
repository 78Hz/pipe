+    {
+        if (event->port_index > 0)
+            return;
+        int type;
+        double v;
+        switch (event->expression_id)
+        {
+        case CLAP_NOTE_EXPRESSION_PRESSURE:   type = 1; v = event->value; break;
+        case CLAP_NOTE_EXPRESSION_BRIGHTNESS: type = 2; v = event->value; break;
+        case CLAP_NOTE_EXPRESSION_TUNING:     type = 3; v = (event->value + 120.0) / 240.0; break;
+        default: return;
+        }
+        const int q = std::max(0, std::min(2097151, static_cast<int>(v * 2097151.0 + 0.5)));
+        for (uint32_t i = 0; i < fClapNoteCount; ++i)
+        {
+            const ClapNote& n(fClapNotes[i]);
+            if (! clapNoteMatches(n, event->note_id, event->channel, event->key))
+                continue;
